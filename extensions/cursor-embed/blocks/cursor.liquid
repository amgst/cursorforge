{%- assign saved = app.metafields.cursorforge.config.value -%}
{%- comment -%} enabled: false = reset to the computer's default cursor, so nothing is output. {%- endcomment -%}
{%- unless saved.enabled == false -%}
{%- liquid

  assign size = 32
  assign hotspot_x = 4
  assign hotspot_y = 2
  assign arrow_color = '#f4511e'
  assign outline = 3
  assign shadow = false
  assign trail = false
  assign trail_length = 8
  assign trail_style = 'dots'
  assign trail_size = 6
  assign trail_color = ''
  assign default_cursor = ''

  if saved.size > 0
    assign size = saved.size
    assign hotspot_x = saved.hotspot_x | at_most: size
    assign hotspot_y = saved.hotspot_y | at_most: size
    assign arrow_color = saved.color
    assign outline = saved.outline
    assign shadow = saved.shadow
    assign trail = saved.trail_enabled
    assign trail_length = saved.trail_length
    if saved.trail_style != blank
      assign trail_style = saved.trail_style
    endif
    if saved.trail_size > 0
      assign trail_size = saved.trail_size
    endif
    assign trail_color = saved.trail_color
    assign default_src = saved.image_url
    if default_src != blank
      unless default_src contains '.svg'
        if default_src contains '?'
          assign default_src = default_src | append: '&width=' | append: size | append: '&height=' | append: size
        else
          assign default_src = default_src | append: '?width=' | append: size | append: '&height=' | append: size
        endif
      endunless
    elsif saved.svg != blank
      assign default_src = saved.svg | base64_encode | prepend: 'data:image/svg+xml;base64,'
    endif
    if default_src != blank
      capture default_cursor
        echo 'url("'
        echo default_src
        echo '") '
        echo hotspot_x
        echo ' '
        echo hotspot_y
      endcapture
    endif
  endif

  if default_cursor == blank
    assign arrow_fill = arrow_color | replace: '#', '%23'
    capture default_cursor
      echo 'url("'
      echo "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='"
      echo size
      echo "' height='"
      echo size
      echo "' viewBox='0 0 64 64'>"
      if shadow
        echo "<defs><filter id='s' x='-20%' y='-20%' width='160%' height='160%'><feDropShadow dx='1' dy='2' stdDeviation='1.5' flood-opacity='0.4'/></filter></defs>"
      endif
      echo "<path d='M8 4 52 36 30 39 20 58Z' fill='"
      echo arrow_fill
      echo "' stroke='white' stroke-width='"
      echo outline
      echo "' stroke-linejoin='round'"
      if shadow
        echo " filter='url(%23s)'"
      endif
      echo "/></svg>"
      echo '") '
      echo hotspot_x
      echo " "
      echo hotspot_y
    endcapture
  endif

  assign pointer_mode = saved.states.pointer.mode | default: 'match'
  assign text_mode = saved.states.text.mode | default: 'system'
  assign loading_mode = saved.states.loading.mode | default: 'system'

  case pointer_mode
    when 'system'
      assign pointer_cursor = 'pointer'
    when 'custom'
      assign pointer_design = saved.states.pointer.design
      assign pointer_size = pointer_design.size | default: 32
      assign pointer_x = pointer_design.hotspot_x | default: 0 | at_most: pointer_size
      assign pointer_y = pointer_design.hotspot_y | default: 0 | at_most: pointer_size
      assign pointer_src = pointer_design.image_url
      if pointer_src != blank
        unless pointer_src contains '.svg'
          if pointer_src contains '?'
            assign pointer_src = pointer_src | append: '&width=' | append: pointer_size | append: '&height=' | append: pointer_size
          else
            assign pointer_src = pointer_src | append: '?width=' | append: pointer_size | append: '&height=' | append: pointer_size
          endif
        endunless
      elsif pointer_design.svg != blank
        assign pointer_src = pointer_design.svg | base64_encode | prepend: 'data:image/svg+xml;base64,'
      endif
      if pointer_src != blank
        capture pointer_image
          echo 'url("'
          echo pointer_src
          echo '") '
          echo pointer_x
          echo ' '
          echo pointer_y
        endcapture
      endif
      if pointer_image == blank
        assign pointer_cursor = 'pointer'
      else
        assign pointer_cursor = pointer_image | append: ', pointer'
      endif
    else
      assign pointer_cursor = default_cursor | append: ', pointer'
  endcase

  case text_mode
    when 'match'
      assign text_cursor = default_cursor | append: ', text'
    when 'custom'
      assign text_design = saved.states.text.design
      assign text_size = text_design.size | default: 32
      assign text_x = text_design.hotspot_x | default: 0 | at_most: text_size
      assign text_y = text_design.hotspot_y | default: 0 | at_most: text_size
      assign text_src = text_design.image_url
      if text_src != blank
        unless text_src contains '.svg'
          if text_src contains '?'
            assign text_src = text_src | append: '&width=' | append: text_size | append: '&height=' | append: text_size
          else
            assign text_src = text_src | append: '?width=' | append: text_size | append: '&height=' | append: text_size
          endif
        endunless
      elsif text_design.svg != blank
        assign text_src = text_design.svg | base64_encode | prepend: 'data:image/svg+xml;base64,'
      endif
      if text_src != blank
        capture text_image
          echo 'url("'
          echo text_src
          echo '") '
          echo text_x
          echo ' '
          echo text_y
        endcapture
      endif
      if text_image == blank
        assign text_cursor = 'text'
      else
        assign text_cursor = text_image | append: ', text'
      endif
    else
      assign text_cursor = 'text'
  endcase

  case loading_mode
    when 'match'
      assign loading_cursor = default_cursor | append: ', progress'
    when 'custom'
      assign loading_design = saved.states.loading.design
      assign loading_size = loading_design.size | default: 32
      assign loading_x = loading_design.hotspot_x | default: 0 | at_most: loading_size
      assign loading_y = loading_design.hotspot_y | default: 0 | at_most: loading_size
      assign loading_src = loading_design.image_url
      if loading_src != blank
        unless loading_src contains '.svg'
          if loading_src contains '?'
            assign loading_src = loading_src | append: '&width=' | append: loading_size | append: '&height=' | append: loading_size
          else
            assign loading_src = loading_src | append: '?width=' | append: loading_size | append: '&height=' | append: loading_size
          endif
        endunless
      elsif loading_design.svg != blank
        assign loading_src = loading_design.svg | base64_encode | prepend: 'data:image/svg+xml;base64,'
      endif
      if loading_src != blank
        capture loading_image
          echo 'url("'
          echo loading_src
          echo '") '
          echo loading_x
          echo ' '
          echo loading_y
        endcapture
      endif
      if loading_image == blank
        assign loading_cursor = 'progress'
      else
        assign loading_cursor = loading_image | append: ', progress'
      endif
    else
      assign loading_cursor = 'progress'
  endcase
-%}

<style>
  @media (pointer: fine) {
    html, body, body * {
      cursor: {{ default_cursor }}, auto !important;
    }
    input:not([type="button"]):not([type="submit"]):not([type="reset"]):not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]):not([type="file"]):not([type="image"]), textarea, [contenteditable="true"] {
      cursor: {{ text_cursor }} !important;
    }
    a, button, summary, label, select, [role="button"], input[type="submit"], input[type="button"], input[type="reset"], input[type="checkbox"], input[type="radio"] {
      cursor: {{ pointer_cursor }} !important;
    }
    html.cursorforge-busy, html.cursorforge-busy *, [aria-busy="true"], [aria-busy="true"] * {
      cursor: {{ loading_cursor }} !important;
    }
  }
</style>
<script>
  addEventListener('beforeunload', function () { document.documentElement.classList.add('cursorforge-busy'); });
  addEventListener('pageshow', function () { document.documentElement.classList.remove('cursorforge-busy'); });
</script>

{%- if trail -%}
  <div
    id="cursorforge-trail"
    hidden
    data-style="{{ trail_style }}"
    data-color="{{ trail_color | default: arrow_color }}"
    data-length="{{ trail_length }}"
    data-size="{{ trail_size }}"
  ></div>
  <script src="{{ 'cursorforge-trail.js' | asset_url }}" defer></script>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "CursorForge cursor",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Design and publish your cursor in the CursorForge app (Apps → CursorForge). Until you publish one, a built-in arrow is shown. After Reset to computer default, the normal cursor is shown."
    }
  ]
}
{% endschema %}
