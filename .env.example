# Copy to .env and fill in your store's public Storefront API credentials.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-public-storefront-token

# Shopify app credentials (server-only, no VITE_ prefix).
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret
