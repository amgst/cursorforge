# Copy to .env and fill in your store's public Storefront API credentials.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-public-storefront-token

# Shopify app credentials (server-only, no VITE_ prefix).
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret

# Optional durable store activity (server-only). Use an Upstash Redis REST database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public HTTPS origin of the app, used by the storefront embed.
ACTIVITY_PUBLIC_URL=https://cursorforge-two.vercel.app
# Long, random owner-only password. Dashboard username: admin.
ACTIVITY_DASHBOARD_PASSWORD=
